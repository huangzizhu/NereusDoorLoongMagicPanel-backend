[Unit]
Description=Nereus Privileged Agent (V2)
Documentation=https://github.com/nereus/privileged-agent
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/nereus/backend

# ── V2 安全配置 ──
Environment=NDLM_PRIVILEGED_AGENT_SOCKET=/run/ndlmpanel/privileged-agent.sock
Environment=NDLM_PRIVILEGED_AGENT_SOCKET_GROUP=backend
Environment=NDLM_PRIVILEGED_AGENT_SOCKET_MODE=660
Environment=NDLM_PRIVILEGED_AGENT_PUBKEY=/etc/nereus/ed25519_pub.pem
Environment=NDLM_PRIVILEGED_AGENT_ALLOWED_UIDS=65534
Environment=NDLM_PRIVILEGED_AGENT_NONCE_TTL=300
Environment=NDLM_PRIVILEGED_AGENT_TIMESTAMP_TOLERANCE=30

ExecStart=/opt/nereus/backend/.venv/bin/python -m privileged_agent.server
Restart=always
RestartSec=2

# ── systemd 安全加固（V2） ──
# 内核防护
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# 文件系统隔离
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/ndlmpanel /opt/ndlmpanel /etc/nginx /var/www /etc/docker /etc/letsencrypt

# 权限提升防护
NoNewPrivileges=yes

# 注意：/run/ndlmpanel 需为 0770 root:backend（由 /etc/tmpfiles.d/nereus.conf 创建），
# 不要用 RuntimeDirectory=ndlmpanel，否则 systemd 会把它重置为 root:root 0750，
# 导致后端无法进入目录（PermissionError）。如需保留，请确保模式允许 backend 组读写。

# 进程退出时清理 IPC
RemoveIPC=yes

# 限制 capabilities：必须含 CAP_DAC_OVERRIDE / CAP_DAC_READ_SEARCH / CAP_CHOWN，
# 否则 root 服务读不了 750 的代码目录（ModuleNotFoundError）且无法 chown socket（EPERM）
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# 内存限制（防止 fork bomb）
MemoryMax=256M
MemoryHigh=192M

[Install]
WantedBy=multi-user.target
